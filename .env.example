# ============================================================================
# LOCAL DEVELOPMENT ONLY.  Save this file as  .env  (exactly that name, in the
# project root next to package.json).  It is already in .gitignore: never commit it.
# Replace every value that says CHANGE-ME.  No quotes, no spaces around "=".
# ============================================================================

# --- AI invoice reading (GRN upload). Create a NEW key at https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE-ME-your-new-gemini-key

# --- Sign-in for the local server
# Session secret: 32+ random characters. Generate one with:  openssl rand -hex 32
APP_SESSION_SECRET=CHANGE-ME-at-least-32-random-characters
# Owner password you will type on the login screen (user name: admin)
ADMIN_PASSWORD=CHANGE-ME-a-strong-password

# --- Supabase (Project settings > API). The "publishable/anon" key is the public one.
VITE_SUPABASE_URL=https://pqjvumdrybjqxrqstams.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_pslHsy59H0ZdQUf72FbOkg_U21bvBQk
SUPABASE_URL=https://pqjvumdrybjqxrqstams.supabase.co
# Server-only secret key (service role). NEVER put this in a VITE_ variable or in GitHub.
SUPABASE_SERVICE_ROLE_KEY=CHANGE-ME-your-service-role-key

# --- Optional server & security settings
# ADMIN_EMAILS=you@example.com
# ADMIN_PHONE=9876543210
# PORT=3000
# HOST=0.0.0.0
# Comma-separated browser origins allowed by CORS when API is hosted separately (e.g. https://app.example.com)
# ALLOWED_ORIGINS=https://your-app-domain.example
# Set to true behind a reverse proxy (Nginx / Cloudflare / Railway / Render) so rate limiting uses client IP
# TRUST_PROXY=1
# API_AUTH_REQUIRED=true
# API_RATE_LIMIT_PER_MIN=600
# IGNORE_DISK_CACHE=0
# DOC_FLOOR_HEADROOM=200
# DOC_HOLD_TTL_MS=43200000
# Override Gemini model preference list for GRN invoice parsing (comma-separated, best first)
# GEMINI_MODELS=
# Developer data-repair override only (keep unset/false in production so saved GST bills cannot be deleted)
# ALLOW_BILL_DELETE=false
# VITE_ALLOW_BILL_DELETE=false

# --- Optional web / Capacitor build-time settings (bundled into client dist/)
# API base URL for standalone SPA / Capacitor APK/IPA builds (e.g. https://api.example.com)
# VITE_API_BASE_URL=
# Subpath prefix for GitHub Pages builds (e.g. /MrWaterBeverages/)
# VITE_BASE_PATH=/
# Route browser Supabase reads, writes, auth and sync signals through the Express server (default off)
# VITE_PROXY_SUPABASE_VIA_SERVER=false

